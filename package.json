{
  "name": "sudoku-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "BASE_PATH=${BASE_PATH:-/openai-quota-watch/} vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:full": "FULL_SAMPLE=1 vitest run tests/batch",
    "e2e": "npm run build:e2e && playwright test",
    "e2e:only": "playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "build:e2e": "npm run build:pages && BUILD_TAG=next BASE_PATH=${BASE_PATH:-/openai-quota-watch/} vite build --outDir dist-next"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "preact": "^10.29.8"
  }
}
